{
  "model": "DermaMap v3",
  "classifier": {
    "arch": "MobileNetV3-Large",
    "file": "skin_model.tflite",
    "img_size": 224,
    "input_range": [0.0, 255.0],
    "input_dtype": "float32",
    "channel_order": "RGB",
    "normalization": "built-in (inside model)",
    "output": "[1,1] sigmoid P(malignant)",
    "trained_on": "ISIC 2019 (dermoscopy) + PAD-UFES-20 (smartphone)",
    "auc_phone_PAD": 0.954,
    "auc_dermoscopy_ISIC": 0.925,
    "note": "PAD malignant is mostly BCC/ACK; melanoma-specific perf not isolated."
  },
  "segmentation": {
    "arch": "U-Net (MobileNetV2)",
    "file": "lesion_seg.tflite",
    "img_size": 256,
    "input_range": [0.0, 255.0],
    "output": "[1,256,256,1] sigmoid mask",
    "trained_on": "ISIC 2018 Task 1",
    "val_dice": 0.905,
    "note": "Consumes the RAW resized image (not the 8-step pipeline). Drives real ABCD."
  },
  "calibration": { "temperature": 1.5, "prior_shift": -0.5 },
  "classes": { "0": "benign", "1": "malignant" },
  "disclaimer": "Research/demo only. Not a medical diagnostic tool."
}
